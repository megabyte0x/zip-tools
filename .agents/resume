#!/usr/bin/env bash
# Fast repair after activation and every wake. Do not install packages here.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

NODE_VERSION="22.23.3"
NODE_HOME="$HOME/.local/node-v${NODE_VERSION}"
NODE_BIN_DIR="$HOME/.local/bin"

if [[ ! -x "$NODE_HOME/bin/node" ]]; then
  echo "Node ${NODE_VERSION} is missing at ${NODE_HOME}; rerun .agents/setup" >&2
  exit 1
fi

mkdir -p "$NODE_BIN_DIR"
tool=""
for tool in node npm npx corepack pnpm pnpx; do
  if [[ ! -x "$NODE_HOME/bin/$tool" ]]; then
    echo "missing ${NODE_HOME}/bin/${tool}; rerun .agents/setup" >&2
    exit 1
  fi
  ln -sfn "$NODE_HOME/bin/$tool" "$NODE_BIN_DIR/$tool"
done

export PATH="$NODE_BIN_DIR:$PATH"

if [[ "$("$NODE_BIN_DIR/node" -p process.version)" != "v${NODE_VERSION}" ]]; then
  echo "Node on PATH is not v${NODE_VERSION}" >&2
  exit 1
fi
if [[ "$("$NODE_BIN_DIR/pnpm" --version)" != "9.12.0" ]]; then
  echo "pnpm on PATH is not 9.12.0" >&2
  exit 1
fi
if ! command -v pandoc >/dev/null 2>&1; then
  echo "pandoc is missing; rerun .agents/setup" >&2
  exit 1
fi

expected="$(git rev-parse HEAD:submodule/zips)"
current=""
if [[ -e submodule/zips/.git ]]; then
  current="$(git -C submodule/zips rev-parse HEAD 2>/dev/null || true)"
fi
if [[ "$current" != "$expected" ]]; then
  echo "ZIP snapshot is '${current}', expected ${expected}; rerun .agents/setup" >&2
  exit 1
fi

printf 'resume ok: node %s, pnpm %s, zips %s\n' \
  "$("$NODE_BIN_DIR/node" -p process.version)" \
  "$("$NODE_BIN_DIR/pnpm" --version)" \
  "$current"
