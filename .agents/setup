#!/usr/bin/env bash
# Prepare a fresh orb: CI's Node 22, pinned pnpm, pandoc, and the ZIP snapshot.
# Idempotent. Amp snapshots the result, so a warm run must skip downloads.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

NODE_VERSION="22.23.3"
NODE_SHA256="df450af89261115ef9f9e3830c3eeb2cc9213b63c720b1af623cb5dcbe2e02de"
NODE_HOME="${NODE_HOME:-$HOME/.local/node-v${NODE_VERSION}}"
# CI uses Node 22. Wrangler 4 refuses anything older; the base image may be newer.
NODE_BIN_DIR="$HOME/.local/bin"

step() {
  local label="$1"
  shift
  local started
  started="$(date +%s)"
  printf '==> %s\n' "$label"
  "$@"
  printf '    done in %ss\n' "$(( $(date +%s) - started ))"
}

ensure_pandoc() {
  if command -v pandoc >/dev/null 2>&1; then
    printf 'pandoc already installed: %s\n' "$(pandoc --version | head -n 1)"
    return
  fi
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends pandoc
}

install_node() {
  if [[ -x "$NODE_HOME/bin/node" ]] && [[ "$("$NODE_HOME/bin/node" -p process.version)" == "v${NODE_VERSION}" ]]; then
    printf 'Node %s already installed at %s\n' "$NODE_VERSION" "$NODE_HOME"
    return
  fi

  local tmp archive
  tmp="$(mktemp -d)"
  archive="$tmp/node.tar.xz"
  curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" -o "$archive"
  echo "${NODE_SHA256}  ${archive}" | sha256sum -c -
  rm -rf "$NODE_HOME"
  mkdir -p "$(dirname "$NODE_HOME")"
  tar -xJf "$archive" -C "$(dirname "$NODE_HOME")"
  mv "$(dirname "$NODE_HOME")/node-v${NODE_VERSION}-linux-x64" "$NODE_HOME"
  rm -rf "$tmp"

  # Corepack lives with this Node. Enable it here so the running script can use pnpm.
  "$NODE_HOME/bin/corepack" enable --install-directory "$NODE_HOME/bin"
  "$NODE_HOME/bin/corepack" prepare pnpm@9.12.0 --activate
}

link_toolchain() {
  mkdir -p "$NODE_BIN_DIR"
  local tool
  for tool in node npm npx corepack pnpm pnpx; do
    ln -sfn "$NODE_HOME/bin/$tool" "$NODE_BIN_DIR/$tool"
  done
  hash -r || true
}

# ~/.local/bin is already on PATH for login shells via ~/.profile, and Amp
# prepends it for supervised services. Do not add another PATH hook.

install_dependencies() {
  export PATH="$NODE_BIN_DIR:$PATH"
  if ! command -v pnpm >/dev/null 2>&1; then
    echo "pnpm is not on PATH after toolchain install" >&2
    exit 1
  fi
  local got
  got="$(pnpm --version)"
  if [[ "$got" != "9.12.0" ]]; then
    echo "expected pnpm 9.12.0, got ${got}" >&2
    exit 1
  fi
  # Frozen install is cheap when the store and node_modules already match the lockfile.
  pnpm install --frozen-lockfile
}

ensure_zips_snapshot() {
  local expected
  expected="$(git rev-parse HEAD:submodule/zips)"
  local current=""
  if [[ -e submodule/zips/.git ]]; then
    current="$(git -C submodule/zips rev-parse HEAD 2>/dev/null || true)"
  fi
  if [[ "$current" == "$expected" ]]; then
    printf 'ZIP snapshot already at %s\n' "$expected"
    return
  fi
  printf 'checking out ZIP snapshot %s\n' "$expected"
  git submodule update --init --recursive
  current="$(git -C submodule/zips rev-parse HEAD)"
  if [[ "$current" != "$expected" ]]; then
    echo "ZIP snapshot is ${current}, expected ${expected}" >&2
    exit 1
  fi
}

write_agent_notes() {
  local notes="$HOME/.config/amp/AGENTS.md"
  mkdir -p "$(dirname "$notes")"
  if [[ -f "$notes" ]] && grep -Fq "# zip-tools orb" "$notes"; then
    return
  fi
  cat >>"$notes" <<'EOF'

# zip-tools orb

- Node 22.23.3 and pnpm 9.12.0 are on PATH via ~/.local/bin. CI uses Node 22; wrangler 4 refuses older Node.
- pandoc is installed. RST ZIPs lose fidelity if the index is built without it.
- submodule/zips is the pinned zcash/zips snapshot. Do not run `git submodule update --remote` unless refreshing data.
- Build the index before the web tests or the dev server: `pnpm index`.
- Dev server: `pnpm --filter @zip-tools/web dev -- --hostname 0.0.0.0 --port "$PORT"`. Playwright expects http://127.0.0.1:3100 unless ZIP_TEST_BASE_URL is set.
- Normal builds stay offline. `pnpm issues:refresh` needs GITHUB_TOKEN or GH_TOKEN and is not part of setup.
EOF
}

step "install pandoc" ensure_pandoc
step "install Node ${NODE_VERSION}" install_node
step "link toolchain" link_toolchain
step "install dependencies" install_dependencies
step "check out ZIP snapshot" ensure_zips_snapshot
step "write agent notes" write_agent_notes

printf 'setup complete: node %s, pnpm %s, pandoc present\n' \
  "$("$NODE_BIN_DIR/node" -p process.version)" \
  "$("$NODE_BIN_DIR/pnpm" --version)"
